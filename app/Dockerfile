# ============================================================
#  第 1 步 FROM：选"基础镜像"（这道菜的底层食材）
# ============================================================
# 说明：
#  - FROM 必须是 Dockerfile 的第一条有效指令（ARG 除外）。
#  - python:3.9-slim = 官方 Python 3.9 的"精简版"镜像。
#      比完整版小几百 MB，跑 Flask 足够用，且已内置 python / pip。
#  - 我们在这份底料上，再加自己的应用代码和依赖，做成新镜像。
FROM python:3.11-slim

# ============================================================
#  第 2 步 WORKDIR：设定容器内的"工作目录"
# ============================================================
# 说明：
#  - 进入容器后，先相当于执行了 `cd /app`。
#  - 之后所有 COPY / RUN / CMD 里的相对路径，都相对 /app 这个目录。
#  - 如果 WORKDIR 指定的目录不存在，Docker 会自动创建它。
WORKDIR /app

# ============================================================
#  第 3 步 COPY + RUN：先装依赖（关键：利用"层缓存"）
# ============================================================
# 说明：
#  - 这里【只复制依赖清单】，先不复制源码。
#  - COPY requirements.txt .  中的第二个 "." 就是上面 WORKDIR 的 /app。
#  - RUN 是"构建镜像时"执行的命令（做菜阶段，只跑这一次）。
#  - pip install 把 flask / pymysql 装进镜像。
#  - --no-cache-dir：不让 pip 留下载缓存，让最终镜像更小。
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt -i https://pypi.tuna.tsinghua.edu.cn/simple

# ============================================================
#  第 4 步 COPY：再复制应用源码
# ============================================================
# 说明：
#  - 把宿主机(构建上下文 /soft/app)里的 app.py 复制进镜像的 /app/app.py。
#  - 为什么要"先依赖、后源码"分两步？见本文件最底部的【层缓存】说明。
COPY app.py .

# ============================================================
#  第 5 步 EXPOSE：声明容器服务端口（纯文档性质）
# ============================================================
# 说明：
#  - 这只是"告诉看镜像的人：我的服务在 5000 端口"。
#  - 它【不会真正打开端口】让外部访问。
#  - 真正让外面浏览器能访问，靠 docker run -p 5000:5000 或 compose 的 ports 配置。
EXPOSE 5000

# ============================================================
#  第 6 步 CMD：容器启动时默认执行的命令
# ============================================================
# 说明：
#  - CMD 是"每次 `docker run` 启动容器时"跑的命令（起服务阶段）。
#  - 等价于在 /app 目录下执行 `python app.py`。
#  - 数组写法是 exec 模式（推荐写法），不是 shell 字符串拼接。
#  - app.py 里写了 app.run(host="0.0.0.0", port=5000)，
#    所以 Flask 会在容器内的 5000 端口提供网页服务。
CMD ["python", "app.py"]

# ============================================================
#  【关键机制】Docker 的"层缓存" —— 为什么把依赖和源码分开写？
# ============================================================
#  Docker 把每一步指令(FROM/COPY/RUN...)做成一个"层"，层会被缓存复用。
#
#  场景：你改了 app.py 里的代码，要重新 docker build。
#    - 因为依赖(requirements.txt)没变：
#        COPY requirements.txt + RUN pip install 这两层【命中缓存，秒过】。
#    - 只有 COPY app.py 和之后的层会重新执行。
#
#  反例：如果你把 `COPY . .`(一股脑复制所有文件) 放在 RUN pip install 之前，
#        那么只要 app.py 一改，缓存就失效，每次都要重装依赖，很慢。
#
#  结论：先 COPY 依赖清单并安装 → 再 COPY 源码，是标准提速写法。
# ============================================================
